# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real keys live in .env; .env.example is the committed template
.env
.env.local
.env.*.local
!.env.example

# local database
*.db
*.db-journal
# WAL mode's sidecar files. The local database runs in WAL so that the
# catalogue sweep and the derived-data builders can work at the same time
# without blocking each other; these two are its runtime state.
*.db-wal
*.db-shm

# generated prisma client
/lib/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database dump produced by `npm run db:dump` for the Turso import.
xine-dump.sql
