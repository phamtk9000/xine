# Local development. Committed on purpose — there are no secrets here yet.
DATABASE_URL="file:./dev.db"

# Any string works locally; set a real random value before deploying.
AUTH_SECRET="xine-local-development-secret-change-me"

# Optional. Leave empty and the app serves the seeded catalogue with generated
# type-plate posters. Set a v3 API read token to pull live film data instead.
TMDB_API_KEY=""
