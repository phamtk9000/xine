// xine — schema
//
// SQLite for local development. To move to Postgres, change the datasource
// provider to "postgresql" and point DATABASE_URL at the new database; no
// model below uses a SQLite-only feature. SQLite has no enums or scalar
// lists, so multi-value fields are stored as comma-separated strings and
// read back through the helpers in lib/serialize.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// The connection URL lives in prisma.config.ts (CLI) and lib/db.ts (runtime).
datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  /// When they proved they can read that inbox. Null means the account
  /// exists but nobody has answered the letter yet, and sign-in refuses it.
  emailVerified DateTime?
  passwordHash  String
  displayName   String
  bio           String?
  location      String?
  /// The member's picture, as a data URI.
  ///
  /// Stored inline rather than as a path or a bucket URL, because there is
  /// no object store here and the filesystem is ephemeral in production —
  /// an uploaded file written to disk would vanish with the invocation that
  /// wrote it. The browser shrinks the image to 256px and re-encodes it
  /// before it is ever sent (see components/avatar-field.tsx), so a row is
  /// on the order of ten kilobytes, and the server refuses anything larger.
  /// Null means the generated plate, which is a real design rather than a
  /// placeholder.
  avatar        String?
  createdAt     DateTime  @default(now())

  ratings     Rating[]
  reviews     Review[]
  watchlist   WatchlistItem[]
  logs        FilmLog[]
  lists       FilmList[]
  projects    Project[]
  briefs      TrailerBrief[]
  activity    Activity[]
  /// Who this member follows, and who follows them.
  following   Follow[]        @relation("follower")
  followers   Follow[]        @relation("following")
  tokens      EmailToken[]
  feedback    FilmFeedback[]
  recSessions RecSession[]
  recEvents   RecEvent[]
  taste       TasteVector?
}

/// One member following another.
///
/// Deliberately one row per direction rather than a symmetric "friendship":
/// following here is a reading choice, not a relationship, and the whole
/// point of taste neighbours is that the interesting follows are usually not
/// reciprocated.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Film {
  id                  String    @id @default(cuid())
  slug                String    @unique
  /// TMDB ids are only unique within a type — a film and a series can share
  /// one — so the pair is what identifies a title.
  tmdbId              Int?
  /// "film" or "series". Both live here rather than in separate tables: they
  /// are rated on the same five axes, appear in the same lists, and the whole
  /// editorial argument treats them as one medium.
  kind                String    @default("film")
  seasons             Int?
  episodes            Int?
  title               String
  originalTitle       String?
  year                Int
  runtime             Int?
  director            String
  country             String?
  /// ISO 3166-1 alpha-2 codes from TMDB's production_countries, comma
  /// separated. Distinct from `country`, which holds the import REGION label
  /// ("Europe") and is therefore useless as geography. Co-productions are the
  /// norm in the cinema this catalogue covers, so it is a list, not a column.
  productionCountries String?
  /// TMDB's `origin_country` — where the film is FROM, as opposed to who
  /// helped pay for it. Narrower than productionCountries and the only one
  /// of the two that answers "whose cinema is this": Inside the Yellow
  /// Cocoon Shell is produced with French, Singaporean, Spanish and Dutch
  /// money, and is a Vietnamese film. The first code is treated as home.
  originCountry       String?
  language            String?
  synopsis            String
  genres              String // comma-separated
  cast                String? // comma-separated
  cinematographer     String?
  composer            String?
  criticScore         Float? // 0–10, editorial/aggregated
  posterUrl           String? // null renders the generated type plate
  backdropUrl         String?
  releasedAt          DateTime?
  createdAt           DateTime  @default(now())

  /// True when a human wrote the synopsis and set the critic score. Imported
  /// films start false and carry TMDB's overview until someone reviews them —
  /// this is what separates the catalogue's breadth from its editorial weight.
  reviewed  Boolean @default(false)
  /// TMDB's own average, kept separate from XINE's critic score so the two
  /// are never confused for each other.
  tmdbScore Float?
  tmdbVotes Int     @default(0)

  /// The next season to air, for series that are already running.
  ///
  /// The calendar reads `releasedAt` for a first appearance, which catches a
  /// brand new series and misses the thing people are actually waiting for —
  /// season four of something they finished last year. TMDB reports this on
  /// the series itself (`next_episode_to_air`), so it lives here rather than
  /// in a table of its own: one series has exactly one *next* season, and the
  /// ones behind it are history the calendar has no use for.
  nextSeason   Int?
  nextSeasonAt DateTime?

  ratings        Rating[]
  reviews        Review[]
  listEntries    ListEntry[]
  watchlistItems WatchlistItem[]
  feedback       FilmFeedback[]
  profile        FilmProfile?
  embedding      FilmEmbedding?
  clusters       FilmCluster[]
  neighbours     FilmNeighbour[] @relation("neighbourOf")
  neighbourOf    FilmNeighbour[] @relation("neighbourTo")
  recEvents      RecEvent[]
  logs           FilmLog[]
  activity       Activity[]
  credits        Credit[]

  @@unique([kind, tmdbId])
  @@index([year])
  @@index([kind])
}

/// A performer. The `cast` string on Film stays as the cheap denormalised
/// list for cards and search; this is the entity you can actually click
/// through to.
model Person {
  id         String   @id @default(cuid())
  slug       String   @unique
  /// TMDB person ids are global, unlike title ids, so this alone identifies
  /// someone and is what the importer dedupes on.
  tmdbId     Int?     @unique
  name       String
  profileUrl String?
  createdAt  DateTime @default(now())

  credits Credit[]

  @@index([name])
}

/// One person's appearance in one title. The character name lives here
/// rather than on Person, because the same actor plays different parts, and
/// not on Film, because a title has many of them.
model Credit {
  id        String  @id @default(cuid())
  personId  String
  filmId    String
  character String?
  /// TMDB billing order — 0 is top-billed. This is what "main characters"
  /// means here: the front of the bill, not everyone who appeared.
  order     Int     @default(999)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  film   Film   @relation(fields: [filmId], references: [id], onDelete: Cascade)

  /// An actor is billed once per title. Doubles as the importer's upsert
  /// key, so a re-run updates rather than duplicating.
  @@unique([personId, filmId])
  @@index([filmId, order])
  @@index([personId])
}

/// A rating is one row per user per film. `overall` is always set; the five
/// axes are optional so a one-tap rating stays a one-tap rating and only
/// people who want the breakdown pay for it.
model Rating {
  id          String   @id @default(cuid())
  userId      String
  filmId      String
  overall     Float
  story       Float?
  direction   Float?
  visual      Float?
  performance Float?
  sound       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([filmId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  body      String
  spoilers  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([filmId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
}

/// One person's private relationship with one film: seen it, liked it.
///
/// The two columns are nullable timestamps rather than booleans on purpose.
/// "Watched" is not a fact on its own — the monthly digest needs to know
/// *when*, and a boolean would force a second table to carry the date. This
/// way a month's viewing is one indexed range scan over `watchedAt`, and
/// un-marking something is a write of null rather than a delete that loses
/// the history.
///
/// Separate from WatchlistItem, which is intent rather than record: the
/// watchlist is what you mean to see, this is what you did.
model FilmLog {
  id        String    @id @default(cuid())
  userId    String
  filmId    String
  watchedAt DateTime?
  likedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([userId, watchedAt])
  @@index([userId, likedAt])
}

model FilmList {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  editorial   Boolean  @default(false)
  /// Which editorial shelf this list sits on — the slug of a collection in
  /// prisma/seed-data/collections.ts ("crime", "love-emotion"). Null for
  /// community lists and for one-off editorial lists that belong to no
  /// shelf, which is why it is a column here rather than its own table: a
  /// collection has a name and an order and nothing else, and seventy-two
  /// lists do not justify a join.
  collection  String?
  /// Where the list sits within its collection. Lists are otherwise ordered
  /// newest-first, which would shuffle a shelf every time one was re-seeded.
  position    Int      @default(0)
  ownerId     String?
  createdAt   DateTime @default(now())

  owner   User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entries ListEntry[]

  @@index([collection, position])
}

model ListEntry {
  id       String  @id @default(cuid())
  listId   String
  filmId   String
  position Int
  note     String?

  list FilmList @relation(fields: [listId], references: [id], onDelete: Cascade)
  film Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([listId, filmId])
}

/// CREATE layer. A project moves through the ten stages defined in
/// lib/stages.ts; each stage's content lives in its own ProjectStage row so
/// stages can be drafted out of order and revised independently.
model Project {
  id         String   @id @default(cuid())
  ownerId    String
  title      String
  genre      String
  premise    String
  logline    String?
  stage      String   @default("idea")
  visibility String   @default("private") // private | community
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stages    ProjectStage[]
  briefs    TrailerBrief[]
  enquiries ServiceEnquiry[]
}

model ProjectStage {
  id        String   @id @default(cuid())
  projectId String
  key       String // see STAGES in lib/stages.ts
  content   String   @default("")
  status    String   @default("empty") // empty | draft | complete
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model TrailerBrief {
  id                String   @id @default(cuid())
  ownerId           String
  projectId         String?
  title             String
  genre             String
  logline           String
  filmReferences    String // comma-separated
  visualReferences  String // newline-separated notes or image URLs
  creativeDirection String   @default("")
  storyboard        String   @default("") // JSON array of shots
  script            String   @default("") // JSON array of beats
  createdAt         DateTime @default(now())

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

/// CONSULT layer. Deliberately not tied to a user account — a producer with a
/// deadline should be able to enquire without signing up.
model ServiceEnquiry {
  id        String   @id @default(cuid())
  projectId String?
  service   String
  name      String
  email     String
  company   String?
  budget    String?
  message   String
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String // rated | reviewed | watched | liked | watchlisted | listed | pitched
  filmId    String?
  listId    String?
  payload   String? // JSON blob for type-specific detail
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film? @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// A one-time link mailed to an address, to prove somebody can read it.
///
/// The token itself is never stored — only its SHA-256 — so a leaked copy of
/// this table cannot be used to take over an account, which is the same
/// reasoning as the password column two models up. Rows are kept after use
/// rather than deleted, because "this link was already used" and "this link
/// never existed" want different answers on screen.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the token that went out in the URL.
  tokenHash String    @unique
  /// "verify" today; "reset" when there is a password reset flow.
  purpose   String    @default("verify")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// A reader's verdict on a recommendation, before they have seen the film.
///
/// Deliberately not a rating. A rating is a judgement of a film somebody
/// watched; this is a judgement of a *suggestion* — "yes, that's the kind of
/// thing I want" or "stop showing me this" — and conflating the two would
/// poison the ratings that the rest of the site reads as opinion.
model FilmFeedback {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  /// "yes", "no", or "never" — see app/actions/recommendations.
  ///
  /// "no" is a mood on a Tuesday: it hides the film from this session and
  /// pushes gently against what it resembles. "never" is a standing
  /// instruction, and is the only one of the three that outlives an evening.
  verdict   String
  /// Optionally why, from a fixed list — "too slow", "too dark". The words
  /// are worth more than the thumb: a rejection with a reason names the
  /// dimension to move, where a bare no can only move all of them a little.
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([filmId])
}

/// One evening's search for something to watch.
///
/// A session is where tonight lives. It holds the answers to the chips, the
/// sentence somebody typed, the intent parsed out of both, and the running
/// adjustments made by every press since — none of which belong in a user's
/// permanent taste, because "funny, under two hours, with friends" is a
/// Friday rather than a personality.
///
/// Kept even when nobody is signed in, addressed by a cookie, because the
/// event log is the raw material for every future improvement to ranking and
/// a signed-out evening is still an evening.
model RecSession {
  id        String   @id @default(cuid())
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The chips, as JSON: {mood, length, era, place, party, …}.
  answers String  @default("{}")
  /// What they typed, verbatim, if anything.
  query   String?
  /// The parsed RecommendationIntent, as JSON — see lib/rec/intent.
  intent  String  @default("{}")
  /// Session-only preference deltas accumulated from feedback, as JSON.
  drift   String  @default("{}")

  /// How sure the ranker is, 0–1. Drives whether a follow-up is worth asking.
  confidence    Float   @default(0)
  /// Which ranking configuration produced this session's ordering.
  modelVersion  String  @default("v1")
  /// Which prompt version parsed the intent, when one did.
  promptVersion String?

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  events RecEvent[]

  @@index([userId, createdAt])
}

/// Every interaction with a recommendation, as it happened.
///
/// Written for a reader that does not exist yet: the evaluation and training
/// pipelines. That means the row has to carry enough context to be
/// interpretable months later without the session's code — the rank the film
/// was shown at, the score it was shown with, and which configuration
/// produced both. A log that only says "user pressed no" cannot teach
/// anything, because it does not say what they were saying no to.
model RecEvent {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  filmId    String?
  /// impression | open | interested | not_tonight | never | seen | save |
  /// more_like_this | less_like_this | rating | filter_changed |
  /// natural_query | finalist_selected | pick_for_me | reason_selected
  type      String
  createdAt DateTime @default(now())

  /// Where in the deck it was shown, and what it scored there.
  rank    Int?
  score   Float?
  /// A fixed-vocabulary reason, when the event carries one.
  reason  String?
  /// Snapshot of anything else worth keeping, as JSON.
  payload String?

  modelVersion  String?
  promptVersion String?

  session RecSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  film    Film?      @relation(fields: [filmId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([userId, type])
  @@index([filmId, type])
}

/// What a film is like, on the dimensions people actually choose by.
///
/// Genre says a film is a Thriller. It does not say whether it is patient or
/// relentless, warm or bleak, easy or demanding — which is what somebody is
/// asking for when they say "something tense but not exhausting". So every
/// film gets a vector of 0–1 values on those dimensions, and the ranker
/// compares vectors rather than matching labels.
///
/// Derived from metadata first, because 12,000 films cannot each cost an AI
/// call, and the derivation is honest about what it is: `source` and
/// `confidence` say where each profile came from, so an editorial or AI
/// profile can overwrite a guess and never the other way round.
model FilmProfile {
  id     String @id @default(cuid())
  filmId String @unique

  /// The dimensions, as JSON: {"pace": 0.3, "darkness": 0.8, …}.
  dims       String
  /// derived | ai | editorial — in ascending order of authority.
  source     String @default("derived")
  confidence Float  @default(0.4)
  /// Bumped when the derivation changes, so stale profiles can be found.
  version    Int    @default(1)

  updatedAt DateTime @updatedAt

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@index([source])
}

/// The stable half of a reader's taste, on the same dimensions as a film.
///
/// Deliberately not the truth. Each dimension carries how sure we are and how
/// many signals it rests on, because a preference inferred from three ratings
/// and one inferred from three hundred should not argue with equal force —
/// and because a reader looking at their own profile deserves to see which
/// parts of it are guesses.
///
/// Updated by bounded exponential moves, so no single evening rewrites it.
model TasteVector {
  id     String @id @default(cuid())
  userId String @unique

  /// {"pace": {"value": 0.42, "confidence": 0.76, "samples": 38}, …}
  dims       String @default("{}")
  /// Affinities that are names rather than numbers: directors, countries.
  affinities String @default("{}")

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A film as a direction in meaning-space.
///
/// Built from its own words — title, synopsis, genres, director, country,
/// keywords — rather than fetched from an embedding API, because an API key
/// this project does not have is not a dependency worth taking for a feature
/// that has to cover the whole catalogue. The hashing trick with inverse
/// document frequency gets most of the way there for text this short, runs in
/// microseconds, and costs nothing to recompute when the recipe changes.
///
/// Stored as base64 of 256 signed bytes: 344 characters a film, against two
/// kilobytes for the same vector written as JSON. At ninety thousand films
/// that is the difference between thirty megabytes and two hundred.
///
/// `model` records how it was made, so the day there is a real embedding
/// service the two can live side by side and be compared rather than
/// swapped on faith.
model FilmEmbedding {
  id     String @id @default(cuid())
  filmId String @unique

  /// base64(Int8Array) — see lib/rec/embed.
  vector String
  /// "hash-tfidf-v1", or the name of whatever service produced it.
  model  String @default("hash-tfidf-v1")
  dims   Int    @default(256)

  updatedAt DateTime @updatedAt

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@index([model])
}

/// A film's membership of an editorial cluster, with how strongly it belongs.
///
/// Clusters are xine's own vocabulary — Quiet Dread, Neon Loneliness, Eat the
/// Rich — and they are not genres. A genre says what happens in a film; a
/// cluster says what it is like to sit through one, which is much closer to
/// how anybody actually chooses. Membership is computed from the semantic
/// profile against the cluster's signature, so a new film joins the right
/// clusters the moment it is imported.
model FilmCluster {
  id      String @id @default(cuid())
  filmId  String
  /// The cluster key from lib/rec/clusters.
  cluster String
  /// 0–1: how well the film fits the signature.
  weight  Float

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([filmId, cluster])
  @@index([cluster, weight])
}

/// Precomputed "films like this one".
///
/// Similarity is expensive and slow to compute and almost never changes, so
/// it is worked out offline and stored as rows: twelve neighbours a film,
/// indexed, fetched by a query that costs nothing. The alternative — loading
/// thousands of vectors into a request and comparing them there — is the
/// version of this that works on a laptop and falls over on a network.
///
/// The score is a blend rather than a cosine. The text vectors alone are
/// weak on sixty-word synopses; the editorial clusters alone are coarse;
/// shared people are precise but narrow. Together they agree often enough to
/// be worth trusting, and `parts` keeps the breakdown so a bad neighbour can
/// be diagnosed rather than guessed at.
model FilmNeighbour {
  id          String @id @default(cuid())
  filmId      String
  neighbourId String
  score       Float
  /// JSON: which signals contributed, and how much.
  parts       String @default("{}")

  film      Film @relation("neighbourOf", fields: [filmId], references: [id], onDelete: Cascade)
  neighbour Film @relation("neighbourTo", fields: [neighbourId], references: [id], onDelete: Cascade)

  @@unique([filmId, neighbourId])
  @@index([filmId, score])
}

/// One row of "this was shown, and here is what happened".
///
/// Built from the event log rather than written live, because a training set
/// is a view of history and should be rebuildable from the history. Every row
/// carries the features as they were at the moment of the impression — the
/// contributions the ranker actually used — so a model trained on this
/// learns from the decisions readers reacted to rather than from a
/// re-ranking under whatever weights are current when the training runs.
///
/// Nothing reads these yet. That is deliberate: the ranker stays
/// deterministic until there is enough clean data to justify anything else,
/// and the way to find out whether there is enough is to have been collecting
/// it properly from the start.
model RecTrainingExample {
  id        String   @id @default(cuid())
  sessionId String
  filmId    String
  createdAt DateTime @default(now())

  /// The score's components at impression time, as JSON.
  features String
  /// Where it appeared in the deck.
  rank     Int
  /// What it scored.
  score    Float

  /// -1 refused, 0 ignored, 1 kept, 2 chosen.
  label   Float
  /// Which event produced the label — "interested", "pick_for_me", …
  outcome String

  modelVersion String

  @@unique([sessionId, filmId])
  @@index([label])
}
