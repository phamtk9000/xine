# Copy to .env before the first run:  cp .env.example .env
# .env is gitignored — real keys go there and never into version control.

DATABASE_URL="file:./dev.db"

# Any string works locally; set a real random value before deploying.
AUTH_SECRET="xine-local-development-secret-change-me"

# Optional, and does two jobs. `npm run films:sync` pulls real poster and
# backdrop art for the catalogue; the film finder also uses it to search
# beyond the catalogue and to report real streaming availability. Without it
# the finder is limited to the seeded films and has no availability data.
TMDB_API_KEY=""

# Which region's streaming availability the finder reports. ISO 3166-1.
TMDB_WATCH_REGION="US"

# Optional. Powers the film finder at /films/find. Without it that page falls
# back to plain keyword search and says so.
ANTHROPIC_API_KEY=""

# Optional. Where `npm run media:sync` reads artwork from.
# MEDIA_SOURCE="/Users/you/Documents/Xine/media"
